# ============================================================
# PREMIUMSHOP — Environment Variables Reference
# Copy this file to .env.local and fill in ALL values.
# Never commit .env.local to version control.
# ============================================================

# ── DATABASE ──────────────────────────────────────────────────
# PostgreSQL connection string (Supabase / Neon / Railway / self-hosted)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/premiumshop?schema=public"

# ── AUTH / JWT ────────────────────────────────────────────────
# 64-character random hex secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="REPLACE_WITH_64_CHAR_HEX_SECRET"

# 64-character random hex for refresh tokens
JWT_REFRESH_SECRET="REPLACE_WITH_ANOTHER_64_CHAR_HEX_SECRET"

# JWT expiry durations
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# ── OTP ───────────────────────────────────────────────────────
# 32-character random hex pepper for hashing OTPs
OTP_PEPPER="REPLACE_WITH_32_CHAR_HEX_PEPPER"

# OTP expiry in minutes (5–10 recommended)
OTP_EXPIRY_MINUTES="10"

# ── RESEND (EMAIL) ────────────────────────────────────────────
# Get your key at https://resend.com/api-keys
RESEND_API_KEY="re_REPLACE_WITH_RESEND_API_KEY"

# The verified sender domain/email you configured in Resend
RESEND_FROM_EMAIL="noreply@yourdomain.com"
RESEND_FROM_NAME="PremiumShop"

# ── CLOUDINARY (IMAGE STORAGE) ────────────────────────────────
# Get these from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
# Cloudinary upload preset (set to "signed" mode in Cloudinary dashboard)
CLOUDINARY_UPLOAD_PRESET="premiumshop_signed"

# ── RAZORPAY (PAYMENTS) ───────────────────────────────────────
# Get from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID="rzp_live_REPLACE"
RAZORPAY_KEY_SECRET="REPLACE_WITH_RAZORPAY_SECRET"
# Webhook secret from Razorpay dashboard → Webhooks
RAZORPAY_WEBHOOK_SECRET="REPLACE_WITH_WEBHOOK_SECRET"
# Exposed to browser (public key only — never the secret)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_live_REPLACE"

# ── APP ──────────────────────────────────────────────────────
# Full URL of your deployment (no trailing slash)
NEXT_PUBLIC_APP_URL="https://yourdomain.com"

# Node environment
NODE_ENV="production"

# ── CSRF ─────────────────────────────────────────────────────
# 32-character random hex secret for signing CSRF tokens
CSRF_SECRET="REPLACE_WITH_32_CHAR_HEX_CSRF_SECRET"

# ── RATE LIMITING ────────────────────────────────────────────
# (Optional) Redis URL for distributed rate limiting
# REDIS_URL="redis://localhost:6379"
